# Переменные HTTP-тестов. Значения рассчитаны на сервисы из compose.yaml.
# Файл лежит в репозитории: все значения заведомо не секретные.

# База именно *_test: глобальная подготовка отказывается работать с другим именем базы.
DATABASE_URL=postgres://studio:studio@localhost:55432/studio_test

S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=studio-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Адрес основного экземпляра приложения в тестах.
APP_URL=http://localhost:3100

APP_TEST_MODE=1
# Заведомо тестовый токен: eval-auth проверяет канал основного экземпляра.
APP_EVAL_MODE=1
EVE_EVAL_AUTH_TOKEN=test-eval-auth-token-0123456789abcdef
EVAL_JUDGE_MODEL=
TEST_APP_PORT=3100

# Тестовый издатель OIDC из tests/http/support/oidc-issuer.ts.
TELEGRAM_CLIENT_ID=424242
TELEGRAM_CLIENT_SECRET=test-client-secret
TELEGRAM_OIDC_ISSUER=http://localhost:59100

# Значения заведомо не секретные: так и задумано для .env.test.
SESSION_SECRET=test-session-secret-0123456789abcdef
DEV_LOGIN_ENABLED=1

# Заведомо непроизводственный ключ из 32 нулевых байт.
SECRETS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FAKE_SANDBOX_DIR=.tmp/fake-sandbox

# Предел одного вложения в тестах — 1 МиБ: «слишком большой» проверяется
# файлом в пару килобайт, а не в гигабайт.
UPLOAD_MAX_BYTES=1048576

# Тестовый сервер Edge TTS из tests/http/support/edge-tts-server.ts.
EDGE_TTS_WSS_URL=ws://127.0.0.1:59101/tts
EDGE_TTS_VOICES_URL=http://127.0.0.1:59101/voices

# Тестовый сервер Tavily из tests/http/support/tavily-server.ts.
TAVILY_API_KEY=tvly-test-key
TAVILY_API_URL=http://127.0.0.1:59102

# Замена yt-dlp. Настоящие ffmpeg и ffprobe остаются системными.
YTDLP_PATH=tests/http/fixtures/ytdlp-stub.mjs
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
DOWNLOAD_MAX_BYTES=5242880
DOWNLOAD_TIMEOUT_MS=60000
YOUTUBE_COOKIES="# Netscape HTTP Cookie File\n.youtube.com\tTRUE\t/\tTRUE\t0\tSID\tFAKE-COOKIE-VALUE"
