# Образец переменных окружения. Скопируйте файл в .env и подставьте свои значения.
# Настоящие секреты в репозиторий не попадают.

# Строка подключения к Postgres. Обязательна.
DATABASE_URL=postgres://studio:studio@localhost:55432/studio_dev

# URL S3-совместимого API. Обязательна. Доступность не проверяется, её видит /api/health.
S3_ENDPOINT=http://localhost:59000

# Регион хранилища (для MinIO-совместимых подойдёт любой). Обязательна.
S3_REGION=us-east-1

# Имя бакета. Обязательна.
S3_BUCKET=studio-dev

# Ключ доступа к хранилищу. Обязательна.
S3_ACCESS_KEY_ID=minioadmin

# Секретный ключ хранилища. Обязательна.
S3_SECRET_ACCESS_KEY=minioadmin

# true, если провайдер требует адресацию «хост/бакет/ключ» (так требует MinIO-совместимое).
# Необязательна, по умолчанию false. Допустимые значения: 1, 0, true, false.
S3_FORCE_PATH_STYLE=true

# Публичный адрес приложения без завершающего /. Обязательна.
APP_URL=http://localhost:3000

# 1 включает тестовые подмены (появятся в следующих тикетах); вместе с NODE_ENV=production запрещена.
# Необязательна. В рабочем .env держите 0; значение 1 предназначено только для .env.test.
APP_TEST_MODE=0

# Порт, на котором HTTP-тесты запускают основной экземпляр приложения.
# Необязательна, по умолчанию 3100. Дополнительные экземпляры берут порты из диапазона 3100–3199.
TEST_APP_PORT=3100

# Каталог сборки Next.js. Необязательна, по умолчанию .next.
# Тесты задают свой каталог на каждый экземпляр (.next-test-<порт>), чтобы запускать их одновременно.
NEXT_DIST_DIR=.next

# Client ID (он же Bot ID) из @BotFather, только цифры. Обязательна при NODE_ENV=production.
# Это же значение проверяется как `aud` в id_token.
TELEGRAM_CLIENT_ID=

# Client Secret из Login Widget в @BotFather, не токен бота.
# Обязателен вместе с TELEGRAM_CLIENT_ID; используется только сервером.
TELEGRAM_CLIENT_SECRET=

# Издатель OIDC. Необязательна, по умолчанию https://oauth.telegram.org.
# Discovery-документ берётся по адресу <издатель>/.well-known/openid-configuration.
# Вне production допускается http:// только вместе с APP_TEST_MODE=1.
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org

# Секрет подписи временной cookie входа OIDC, не короче 32 символов. Обязательна всегда.
# Получить свой: openssl rand -base64 48
# Значение ниже годится только для локальной разработки: в production оно отвергается.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcd

# Срок жизни сессии входа, целое число дней от 1 до 365. Необязательна, по умолчанию 30.
SESSION_TTL_DAYS=30

# 1 включает вход без Telegram. Разрешён только на localhost, 127.0.0.1 или [::1]
# и никогда в production. Для рабочего окружения оставьте пустой или 0.
DEV_LOGIN_ENABLED=1

# Имя модели агента. Обязательна всегда, кроме APP_TEST_MODE=1.
# Без AGENT_MODEL_BASE_URL это идентификатор модели для AI Gateway.
# При модели без AGENT_MODEL_BASE_URL сам AI SDK читает ключ AI Gateway из
# AI_GATEWAY_API_KEY (вне Vercel); конфигурация эту переменную не проверяет.
AGENT_MODEL=

# Базовый URL провайдера. Необязательна: не задана —
# AGENT_MODEL это идентификатор для AI Gateway.
# Для AGENT_MODEL_API=anthropic адрес должен заканчиваться на /v1:
# запросы идут в <адрес>/messages.
AGENT_MODEL_BASE_URL=

# Ключ провайдера. Обязателен, если задан AGENT_MODEL_BASE_URL.
AGENT_MODEL_API_KEY=

# Протокол провайдера: openai (Chat Completions, по умолчанию) или anthropic
# (Messages API). Адрес и ключ те же.
AGENT_MODEL_API=openai

# Размер контекстного окна модели в токенах, целое число не меньше 8000.
# Обязателен, если задан AGENT_MODEL_BASE_URL: каталог AI Gateway не знает
# чужих моделей, а eve использует окно для сжатия истории.
AGENT_MODEL_CONTEXT_TOKENS=

# true — нативный поток провайдера (по умолчанию).
# false — обычный ответ API с сохранением потокового интерфейса eve;
# для провайдеров без корректной потоковой передачи инструментов. Нужен AGENT_MODEL_BASE_URL.
AGENT_MODEL_STREAMING=true

# Уровень рассуждения: provider-default, none, minimal, low, medium, high, xhigh.
# Необязательна, по умолчанию high.
AGENT_REASONING=high

# Режим оценок: только localhost, не production. Для настоящей модели APP_TEST_MODE=0;
# сочетание с APP_TEST_MODE=1 используется HTTP-тестами с фикстурной моделью.
# Тот же случайный токен передайте процессу `eve eval --url`.
APP_EVAL_MODE=0
# Изолированный сервер оценок видео: настоящий Remotion в локальном Docker, без Daytona.
# Требует APP_EVAL_MODE=1; обычный вход на таком экземпляре закрыт.
APP_VIDEO_EVAL_SANDBOX=0
# Записанные кадры для оценок с подменой всех инструментов; без рендера и Daytona.
# Только отдельный eval-сервер; несовместим с APP_VIDEO_EVAL_SANDBOX=1.
APP_STUB_EVAL_SANDBOX=0
EVE_EVAL_AUTH_TOKEN=

# Необязательная модель судьи eve eval; пусто — умолчание eve.
# При заданном AGENT_MODEL_BASE_URL использует его и AGENT_MODEL_API_KEY.
# Эти переменные нужны процессу оценок; конфигурация приложения судье не нужна.
EVAL_JUDGE_MODEL=

# Каталог сохранения результатов и незавершённых сессий оценок.
# Необязателен: two-of-three.mjs задаёт его сам, --resume продолжает тот же каталог.
EVAL_CHECKPOINT_DIR=

# Ключ шифрования секретов в базе, ровно 32 байта в base64. Обязателен всегда.
# Получить: openssl rand -base64 32. Сохраните надёжно: замена лишит доступа к старым секретам.
SECRETS_ENCRYPTION_KEY=

# Адрес API Daytona. Необязателен, по умолчанию https://app.daytona.io/api.
DAYTONA_API_URL=https://app.daytona.io/api

# vCPU, целое 1–4. Необязательна, по умолчанию 2.
SANDBOX_CPU=2

# Память в ГБ, целое 3–8. Необязательна, по умолчанию 4.
SANDBOX_MEMORY_GB=4

# Диск в ГБ, целое 1–10. Необязательна, по умолчанию 8.
SANDBOX_DISK_GB=8

# Простой до остановки: целое число минут от 1 до 1440, по умолчанию 15.
SANDBOX_IDLE_STOP_MINUTES=15
# Архивация после остановки: целое число суток от 1 до 30, по умолчанию 7.
SANDBOX_ARCHIVE_AFTER_DAYS=7
# Предел ожидания места: целое число секунд от 5 до 14400, по умолчанию 1800.
SANDBOX_QUEUE_MAX_WAIT_SECONDS=1800
# Проверка очереди: целое число миллисекунд от 100 до 10000, по умолчанию 2000.
SANDBOX_QUEUE_POLL_MS=2000

# Предельный размер файла из ответа агента, который копируется в S3, в байтах.
# Необязательна, по умолчанию 2147483648 (2 ГиБ). Больший файл не сохраняется,
# в ответе остаётся «Файл слишком большой и не сохранён».
MEDIA_COPY_MAX_BYTES=2147483648

# Предельный размер одного загружаемого файла, байты; не больше 5368709120
# (одиночный PUT в S3 ограничен 5 ГБ). Необязательна, по умолчанию 268435456 (256 МиБ):
# eve держит файл в памяти целиком, пик примерно в пять раз больше файла.
UPLOAD_MAX_BYTES=268435456

# Ключ Tavily для инструмента web_search (https://app.tavily.com, 1000 кредитов в месяц без карты).
# Необязателен: без него сервер стартует, а поиск отвечает, что ключ не задан.
# Запрос уходит с заголовком Authorization: Bearer. basic — 1 кредит, advanced — 2.
TAVILY_API_KEY=

# Базовый адрес API Tavily без завершающего /. Необязателен, по умолчанию https://api.tavily.com.
# http:// допустим только вместе с APP_TEST_MODE=1.
TAVILY_API_URL=https://api.tavily.com

# Каталог фиктивной песочницы. Обязателен только при APP_TEST_MODE=1.
# Относительный путь разрешается от корня проекта; для рабочего приложения оставьте пустым.
FAKE_SANDBOX_DIR=

# Адрес WebSocket синтеза Edge TTS. Необязателен: пустое значение — адрес из библиотеки.
# Нужен, чтобы сменить сервис без новой версии и чтобы тесты подставили свой сервер.
EDGE_TTS_WSS_URL=

# Адрес списка голосов Edge TTS. Необязателен: пустое значение — адрес из библиотеки.
EDGE_TTS_VOICES_URL=

# Скачивание видео. Бинарники не ставятся npm install: yt-dlp — релиз или
# `yt-dlp[default]`, ffmpeg и ffprobe — пакеты системы. Путь к yt-dlp.
# Необязателен, по умолчанию yt-dlp из PATH.
YTDLP_PATH=yt-dlp

# Каталог или файл ffmpeg, который yt-dlp получит как --ffmpeg-location.
# Необязателен: без него yt-dlp ищет ffmpeg сам. Значение без «/» берётся из PATH
# и передаётся абсолютным путём.
FFMPEG_PATH=

# ffprobe для длительности и кодека. Необязателен, по умолчанию ffprobe из PATH.
FFPROBE_PATH=ffprobe

# Среда JavaScript для страниц, которые yt-dlp разбирает скриптом:
# node, deno или quickjs, можно с путём через двоеточие (deno:/usr/local/bin/deno).
# bun не поддерживается и отклоняется при вызове. Необязателен, по умолчанию node.
YTDLP_JS_RUNTIME=node

# Cookies Netscape для YouTube, одна строка или несколько. Первая строка —
# «# Netscape HTTP Cookie File» или «# HTTP Cookie File». Литералы \n и \r\n
# раскрываются. Необязателен: без него ролики, требующие входа, не скачиваются.
# Не передавайте cookies основного аккаунта.
YOUTUBE_COOKIES=

# Предел размера одного видео, байты. Необязателен, по умолчанию 1073741824 (1 ГиБ),
# не меньше 1048576. Файл целиком держится в памяти процесса, пока копируется в песочницу.
DOWNLOAD_MAX_BYTES=1073741824

# Срок шага «сведения и скачивание», миллисекунды. Необязателен, по умолчанию 600000
# (10 минут). Допустимо от 10000 до 3600000. Кадры, очередь и доставка считаются отдельно.
DOWNLOAD_TIMEOUT_MS=600000
